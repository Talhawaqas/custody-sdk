{
  "name": "@inaya-network/custody-sdk",
  "version": "1.0.9-beta",
  "description": "Client-side cryptographic sovereignty SDK for the Inaya Network — encrypt, shard, anchor, and reconstruct files against BNB Chain Testnet.",
  "type": "module",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
